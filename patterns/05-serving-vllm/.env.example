# Copy to .env and fill in. .env is git-ignored; this file is committed and must never
# contain a real secret — it documents the shape of the configuration, not its values.
#
#   cp .env.example .env
#
# Variables written as ${VAR:?message} in docker-compose.yml have no default on purpose:
# the contour refuses to start rather than come up with a well-known password.

# --- Neo4j ---------------------------------------------------------------------------
NEO4J_PASSWORD=change_me_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP=1G

# --- Redis ---------------------------------------------------------------------------
REDIS_PORT=6379
# A cache must have a memory ceiling and an eviction policy, otherwise it is a memory leak
# with extra steps. allkeys-lru is set in docker-compose.yml.
REDIS_MAXMEMORY=512mb
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_S=3600

# --- Inference -----------------------------------------------------------------------
# The host Ollama daemon, reached from inside the container. It must be started with
# OLLAMA_HOST=0.0.0.0 — the default binds 127.0.0.1 and is unreachable from Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:7b
# Only read by the `linux-gpu` profile, where Ollama runs as a container.
OLLAMA_PORT=11435
OLLAMA_NUM_PARALLEL=4

# --- App -----------------------------------------------------------------------------
APP_PORT=8080

# =====================================================================================
# Everything below is only needed for `--profile tracing`. Leave as-is to run without it.
#
#   openssl rand -base64 32   # -> LANGFUSE_NEXTAUTH_SECRET
#   openssl rand -base64 32   # -> LANGFUSE_SALT
#   openssl rand -hex 32      # -> LANGFUSE_ENCRYPTION_KEY (exactly 64 hex chars)
# =====================================================================================
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=langfuse

LANGFUSE_PORT=3000
LANGFUSE_NEXTAUTH_SECRET=change_me_openssl_rand_base64_32
LANGFUSE_SALT=change_me_openssl_rand_base64_32
LANGFUSE_ENCRYPTION_KEY=change_me_openssl_rand_hex_32_64chars
# Keys the headless bootstrap creates on first boot; the app authenticates with them.
LANGFUSE_PUBLIC_KEY=pk-lf-0000000000000000
LANGFUSE_SECRET_KEY=sk-lf-0000000000000000
LANGFUSE_USER_EMAIL=dojo@localhost
LANGFUSE_USER_PASSWORD=change_me_langfuse
# Set to http://langfuse:3000 when running with --profile tracing; empty disables tracing.
LANGFUSE_HOST=
